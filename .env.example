# Copy to supabase/functions/.env for local Edge Function testing,
# and set the same names as Supabase secrets:  supabase secrets set --env-file supabase/functions/.env
# NEVER commit the real file. NEVER put these values in public/js/config.js.

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AI providers (pick one)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Events (Phase 4)
TICKETMASTER_API_KEY=
